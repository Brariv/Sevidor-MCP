# Chatbot host (FastAPI) que habla con el MCP server remoto en Cloud Run.
# Se construye desde la raíz del repo:  docker build -f Dockerfile.chatbot .
FROM python:3.12-slim

WORKDIR /app

# tcpdump: para capturar desde dentro del contenedor (Docker Desktop en macOS/Windows
# corre en una VM, así que Wireshark en el host no ve la interfaz del contenedor).
RUN apt-get update \
 && apt-get install -y --no-install-recommends tcpdump \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-chatbot.txt .
RUN pip install --no-cache-dir -r requirements-chatbot.txt

# Misma estructura que el repo: /app/src/ChatBot  →  logs en /app/src/logs
COPY src/ChatBot/ ./src/ChatBot/

WORKDIR /app/src
ENV PYTHONUNBUFFERED=1

# Carpeta compartida con el host para sslkeys.log y los .pcap
RUN mkdir -p /app/captura
VOLUME ["/app/captura"]

EXPOSE 8500

CMD ["python", "-m", "uvicorn", "ChatBot.WebAPI:app", "--host", "0.0.0.0", "--port", "8500"]
